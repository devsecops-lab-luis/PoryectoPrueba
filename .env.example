# Environment variables example

# Postgres
DATABASE_URL=postgresql://proyectoprueba:password@postgres:5432/proyectoprueba?schema=public

# App
PORT=3000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=your_access_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_ACCESS_EXPIRATION=900s
JWT_REFRESH_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Prisma
SHADOW_DATABASE_URL=postgresql://proyectoprueba:password@postgres:5432/proyectoprueba_shadow?schema=public
